  const [showAnalytics, setShowAnalytics] = useState(true);

  const handleGenerate = (protocol: string, ex: Exercise[], nut: Nutrition) => {
    setCurrentProtocol(protocol);
    setExercises(ex);
    setNutrition(nut);
  };

  // Mock data for analytics
  const analyticsData = {
    workoutsThisWeek: 4,
    caloriesBurned: 2850,
    progressPercentage: 75,
    streakDays: 14
