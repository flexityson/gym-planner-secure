          <p>Unlock advanced analytics, progress tracking, and community features</p>
          <div className="premium-features">
            <div className="premium-feature">
              <i className="fas fa-brain"></i>
              <div>AI Workout Optimization</div>
            </div>
            <div className="premium-feature">
              <i className="fas fa-video"></i>
              <div>Form Analysis Videos</div>
            </div>
            <div className="premium-feature">
              <i className="fas fa-chart-pie"></i>
              <div>Advanced Analytics</div>
            </div>
          </div>
        </div>

        <div className="grid">
          <ConfigPanel onGenerate={handleGenerate} />
          <ResultsPanel 
            protocol={currentProtocol}
            exercises={exercises}
            nutrition={nutrition}
          />
        </div>

        {showAnalytics && (
          <>
            <AnalyticsDashboard {...analyticsData} />
            
            <div className="grid" style={{ marginTop: '30px' }}>
              <ProgressTracker />
              <CommunitySharing />
            </div>
          </>
        )}

        <div className="achievement-badges">
          <div className="badge-item unlocked">
            <i className="fas fa-dumbbell"></i>
            <span>First Workout</span>
          </div>
          <div className="badge-item unlocked">
            <i className="fas fa-fire"></i>
            <span>7-Day Streak</span>
